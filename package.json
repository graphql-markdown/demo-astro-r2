{
  "name": "demo-astro-r2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "version": "1.35.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node -e \"require('node:fs').cpSync('.markdown-copies','dist/client',{recursive:true})\"",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "doc": "node scripts/generate-docs.ts && node scripts/generate-copies.ts",
    "doc:force": "node scripts/generate-docs.ts --force && node scripts/generate-copies.ts",
    "gqlmd": "gqlmd",
    "check": "wrangler types && astro check",
    "doc:verify": "node scripts/verify-docs.ts",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/starlight": "^0.43.1",
    "@catppuccin/starlight": "^2.1.0",
    "@graphql-markdown/cli": "^1.3.0",
    "@graphql-markdown/core": "^1.28.0",
    "@graphql-markdown/diff": "^1.1.26",
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/graphql": "^1.4.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "@graphql-tools/url-loader": "^10.0.9",
    "astro": "^7.4.13",
    "astro-breadcrumbs": "^3.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.2",
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "@graphql-markdown/types": "1.19.0",
    "@graphql-markdown/utils": "^1.14.4",
    "@graphql-markdown/logger": "1.1.6",
    "@graphql-markdown/graphql": "$@graphql-markdown/graphql",
    "@graphql-markdown/helpers": "1.2.7",
    "@graphql-markdown/printer-legacy": "$@graphql-markdown/printer-legacy",
    "@catppuccin/starlight": {
      "@astrojs/starlight": "$@astrojs/starlight"
    }
  }
}
