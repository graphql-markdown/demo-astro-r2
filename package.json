    "@graphql-markdown/formatters": "^1.2.1",
    "@graphql-tools/graphql-file-loader": "^9.1.1",
    "astro": "^7.4.4",
    "astro-breadcrumbs": "^3.4.2",
    "sharp": "^0.35.5"
