---
/**
 * Starlight's footer, with a GraphQL-Markdown credit (and a link to star the
 * project on GitHub) in place of "Built with Starlight".
 *
 * Starlight's own credit is switched off in astro.config.ts (`credits: false`)
 * and this renders the replacement after the default footer, so the edit link,
 * last-updated line and pagination stay entirely Starlight's.
 */
import Default from "@astrojs/starlight/components/Footer.astro";

import darkMark from "../assets/graphql-markdown-dark.svg";
import lightMark from "../assets/graphql-markdown.svg";
---

<Default />

<div class="kudos sl-flex">
  <a class="sl-flex" href="https://graphql-markdown.dev/">
    <img src={darkMark.src} class="light:sl-hidden" width="16" height="16" alt="" />
    <img src={lightMark.src} class="dark:sl-hidden" width="16" height="16" alt="" />
    Built with GraphQL-Markdown
  </a>
  <span aria-hidden="true">·</span>
  <a href="https://github.com/graphql-markdown/graphql-markdown">⭐ Star on GitHub</a>
</div>

<style>
  /*
   * Starlight centred its own credit as a flex item of the footer column. This
   * one is a sibling of that footer, so it is a full-width flex container
   * instead and `margin: auto` has nothing to distribute — centre its contents.
   */
  .kudos {
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    margin: 1.5rem auto;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .kudos a {
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: inherit;
  }

  .kudos a:hover {
    color: var(--sl-color-white);
  }

  .kudos img {
    width: 1.2em;
    height: 1.2em;
  }
</style>

<style is:global>
  /*
   * Keep the footer at the bottom of the viewport on short pages: stretch the
   * main column to the screen height and let the content above the footer
   * take the extra space.
   */
  .main-pane > main {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
  }
  .main-pane > main > .content-panel:last-child,
  .main-pane > main > .content-panel:last-child > .sl-container {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .main-pane > main > .content-panel:last-child > .sl-container {
    width: 100%;
  }
  .main-pane > main > .content-panel:last-child > .sl-container > :has(+ footer) {
    flex-grow: 1;
  }
</style>
